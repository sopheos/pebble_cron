{
    "name": "sopheos/pebble_cron",
    "description": "Cron runner that launches each due job in a background PHP process, with lock, crash and JSON log files",
    "license": "MIT",
    "require": {
        "php": ">=8.5.0",
        "ext-posix": "*",
        "symfony/process": "^8",
        "dragonmantank/cron-expression": "^3.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13"
    },
    "autoload": {
        "psr-4": {
            "Pebble\\Cron\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
